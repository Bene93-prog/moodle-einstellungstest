# ---------------------------------------------------------------------
#  Kopie als ".env" anlegen und ausfuellen. NICHT ins Git-Repo committen!
# ---------------------------------------------------------------------

# --- Version-Pinning (bestimmt, welche Moodle-Version gebaut wird) ---
MOODLE_BRANCH=MOODLE_405_STABLE
PHP_VERSION=8.3

# --- Datenbank (starke, zufaellige Passwoerter erzeugen!) ---
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=CHANGE_ME_starkes_passwort
DB_ROOT_PASSWORD=CHANGE_ME_anderes_starkes_passwort


# =====================================================================
#  PHASE 1 — lokaler Betrieb per IP (HTTP), zum Aufbauen und Testen
# =====================================================================
# wwwroot exakt inkl. Port, so wie im Browser aufgerufen:
MOODLE_WWWROOT=http://192.168.0.10:8080
MOODLE_COOKIESECURE=false
MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY=false

# =====================================================================
#  PHASE 2 — Produktion ueber Nginx Proxy Manager (HTTPS, Domain)
# ---------------------------------------------------------------------
#  Fuer die Umstellung obige Phase-1-Zeilen auskommentieren und diese
#  aktivieren, danach im Container die Caches leeren (siehe Runbook 2.4).
# =====================================================================
# MOODLE_WWWROOT=https://moodle.deine-domain.de
# MOODLE_COOKIESECURE=true
# MOODLE_REVERSEPROXY=true
# MOODLE_SSLPROXY=true
